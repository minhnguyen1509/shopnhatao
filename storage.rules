rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Chỉ tài khoản nội bộ (nhân viên @staff.shopnhatao.com hoặc email chủ shop) được tải ảnh.
    function isStaff() {
      return request.auth != null && request.auth.token.email != null && (
        request.auth.token.email.matches('.*@staff[.]shopnhatao[.]com$')
        || request.auth.token.email.lower() == 'mhn15920@gmail.com'
      );
    }
    match /products/{file} {
      allow read: if true;
      allow create, update: if isStaff()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isStaff();
    }
    match /{all=**} { allow read, write: if false; }
  }
}
